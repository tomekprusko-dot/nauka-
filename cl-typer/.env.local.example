# Skopiuj ten plik do .env.local (który jest w .gitignore — nigdy nie commituj
# prawdziwych kluczy) i uzupełnij wartościami z Twojego projektu Supabase.

# Project Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Project Settings → API → service_role key (SEKRETNY — pełny dostęp do bazy,
# używany tylko po stronie serwera; nigdy nie prefiksuj go NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Losowy sekret do podpisywania ciasteczka sesji logowania.
# Wygeneruj np. poleceniem: openssl rand -base64 32
SESSION_SECRET=
