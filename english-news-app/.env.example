# Wymagane — klucz z https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Wymagane do trwałego zapisu (bez tego dane znikają po każdym "cold starcie").
# Te dwie zmienne Vercel wstawia SAM, gdy w zakładce Storage dodasz bazę
# (Marketplace Database Providers -> Upstash / Redis) i połączysz ją z projektem.
# Do lokalnego developmentu pobierz je poleceniem: vercel env pull .env.local
KV_REST_API_URL=
KV_REST_API_TOKEN=

DEFAULT_LEVEL=B1
ARTICLES_PER_FEED=8
SUMMARIZE_BATCH_SIZE=4
MAX_STORED_ARTICLES=150
